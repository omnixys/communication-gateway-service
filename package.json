{
  "name": "communication-gateway-service",
  "version": "3.0.0",
  "description": "Omnixys Communication Gateway \u2013 External Provider Integration Layer",
  "author": {
    "name": "Caleb Gyamfi",
    "email": "caleb.gyamfi@omnixys.com",
    "url": "https://omnixys.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omnixys/communication-gateway-service.git"
  },
  "bugs": {
    "url": "https://github.com/omnixys/communication-gateway-service/issues"
  },
  "homepage": "https://omnixys.com",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.8.1 <27",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo *.tsbuildinfo",
    "build": "pnpm run clean && nest build",
    "format": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\" \"__tests__/**/*.ts\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --cache --check \"src/**/*.{ts,js,json,prisma,md,yaml,yml}\" \"__tests__/**/*.ts\" --no-error-on-unmatched-pattern",
    "start": "pnpm nest start",
    "dev": "pnpm run clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build && node --env-file=__tests__/unit/test.env --test __tests__/unit/*.test.mjs",
    "test:integration": "pnpm run build && node --env-file=__tests__/unit/test.env --test __tests__/integration/*.test.mjs",
    "prisma:generate": "node scripts/prisma.mts generate --schema prisma/schema.prisma",
    "prisma:migrate": "node scripts/prisma.mts migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "node scripts/prisma.mts migrate deploy --schema prisma/schema.prisma",
    "prisma:reset": "node scripts/prisma.mts migrate reset --force --schema prisma/schema.prisma",
    "prisma:studio": "node scripts/prisma.mts studio --schema prisma/schema.prisma",
    "prisma:validate": "node scripts/prisma.mts validate --schema prisma/schema.prisma",
    "release": "semantic-release",
    "postinstall": "node scripts/prisma.mts generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.14.4",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-fastify": "^11.2.3",
    "@omnixys/contracts-ts": "^4.5.0",
    "@omnixys/kafka-ts": "^4.3.1",
    "@omnixys/logger-ts": "^4.2.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "fastify": "5.8.5",
    "graphql": "^17.0.2",
    "kafkajs": "^2.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.2",
    "@tsconfig/node23": "^23.0.5",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prisma": "^6.19.3",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
