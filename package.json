{
  "name": "communication-gateway-service",
  "version": "3.0.0",
  "description": "Omnixys Communication Gateway – External Provider Integration Layer",
  "author": {
    "name": "Caleb Gyamfi",
    "email": "caleb.gyamfi@omnixys.com",
    "url": "https://omnixys.com"
  },
  "repository": {
    "type": "git",
    "url": "https://git.omnixys.com/omnixys/communication-gateway-service.git"
  },
  "bugs": {
    "url": "https://git.omnixys.com/omnixys/communication-gateway-service/issues"
  },
  "homepage": "https://omnixys.com",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.8.1 <27",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo *.tsbuildinfo",
    "build": "pnpm run clean && nest build",
    "format": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\"",
    "format:test": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\" \"__tests__/**/*.ts\" \"__tests__/**/*.{ts,mjs}\"",
    "format:check": "prettier --cache --check \"src/**/*.{ts,js,json,prisma,md,yaml,yml}\" \"__tests__/**/*.{ts,mjs}\" --no-error-on-unmatched-pattern",
    "start": "pnpm nest start",
    "dev": "pnpm run clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,__tests__}/**/*.{ts,mjs}\"",
    "typedoc": "typedoc",
    "depcheck": "depcheck",
    "prepare": "husky",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "generate": "pnpm run prisma:generate",
    "release": "semantic-release",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build && node --experimental-test-module-mocks --env-file=__tests__/unit/test.env --test __tests__/unit/*.test.mjs __tests__/unit/*.test.ts",
    "test:integration": "pnpm run build && node --env-file=__tests__/unit/test.env --test __tests__/integration/*.test.mjs",
    "test:e2e": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:typecheck": "pnpm run build && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "2.14.4",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/axios": "^12.0.1",
    "dotenv": "^17.4.2",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^12.1.0",
    "@omnixys/cache-ts": "^5.0.0",
    "@omnixys/context-ts": "^5.0.0",
    "@omnixys/contracts-ts": "^5.0.0",
    "@omnixys/graphql-ts": "^5.0.0",
    "@omnixys/grpc-ts": "^3.0.0",
    "@omnixys/http-ts": "^3.0.0",
    "@omnixys/kafka-ts": "^5.0.0",
    "@omnixys/logger-ts": "^5.0.0",
    "@omnixys/observability-ts": "^5.0.0",
    "@omnixys/security-ts": "^6.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.8.5",
    "graphql": "^16.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^11.14.0",
    "@tsconfig/node23": "^23.0.5",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prisma": "^7.10.0",
    "semantic-release": "^25.0.9",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
