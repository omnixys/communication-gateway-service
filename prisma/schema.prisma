generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Runtime configuration of a provider adapter.
model ProviderConfig {
  id           String   @id @db.VarChar(36)
  providerType String   @unique @map("provider_type") @db.VarChar(50)
  enabled      Boolean  @default(true)
  settings     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("provider_configs")
}

/// Observed connection state of a provider adapter.
model ProviderConnection {
  id           String    @id @db.VarChar(36)
  providerType String    @map("provider_type") @db.VarChar(50)
  status       String    @default("DISCONNECTED") @db.VarChar(20)
  details      Json?
  connectedAt  DateTime? @map("connected_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("provider_connections")
}

/// Append-only log of delivery attempts.
model DeliveryLog {
  id                String   @id @db.VarChar(36)
  messageId         String   @map("message_id") @db.VarChar(36)
  providerType      String   @map("provider_type") @db.VarChar(50)
  status            String   @default("PENDING") @db.VarChar(20)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(255)
  error             String?
  tenantId          String   @default("") @map("tenant_id") @db.VarChar(36)
  attempts          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([messageId], map: "ix_delivery_logs_message_id")
  @@map("delivery_logs")
}

/// Mapping between an internal message id and a provider message id.
model MessageMapping {
  id                String    @id @default(uuid()) @db.VarChar(36)
  internalId        String    @unique @map("internal_id") @db.VarChar(36)
  providerMessageId String    @unique @map("provider_message_id") @db.VarChar(255)
  provider          String    @db.VarChar(50)
  channel           String    @db.VarChar(20)
  conversationId    String    @map("conversation_id") @db.VarChar(36)
  sender            String    @default("") @db.VarChar(255)
  recipient         String    @default("") @db.VarChar(255)
  status            String    @default("PENDING") @db.VarChar(20)
  tenantId          String    @default("") @map("tenant_id") @db.VarChar(36)
  organizationId    String    @default("") @map("organization_id") @db.VarChar(36)
  providerInstance  String    @default("") @map("provider_instance") @db.VarChar(100)
  retryCount        Int       @default(0) @map("retry_count")
  lastStatusChange  DateTime? @map("last_status_change")
  lastError         String?   @map("last_error")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([internalId], map: "ix_message_mappings_internal_id")
  @@index([providerMessageId], map: "ix_message_mappings_provider_message_id")
  @@index([conversationId], map: "ix_message_mappings_conversation_id")
  @@index([provider, providerMessageId], map: "ix_message_mappings_provider_provider_msg_id")
  @@map("message_mappings")
}

/// Transactional outbox for analytics events awaiting a Kafka publish.
model AnalyticsOutbox {
  id               String    @id @default(uuid()) @db.VarChar(36)
  deduplicationKey String    @map("deduplication_key") @db.VarChar(500)
  tenantId         String    @map("tenant_id") @db.VarChar(36)
  topic            String    @db.VarChar(200)
  payload          Json
  correlationId    String?   @map("correlation_id") @db.VarChar(255)
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at")
  lockedAt         DateTime? @map("locked_at")
  lockedBy         String?   @map("locked_by") @db.VarChar(36)
  publishedAt      DateTime? @map("published_at")
  deadLetteredAt   DateTime? @map("dead_lettered_at")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([deduplicationKey], map: "uq_analytics_outbox_deduplication_key")
  @@index([tenantId], map: "ix_analytics_outbox_tenant_id")
  @@index([publishedAt, deadLetteredAt, nextAttemptAt], map: "ix_analytics_outbox_ready")
  @@map("analytics_outbox")
}
