# communication-gateway environment template
#
# Copy to .env for local development: cp .env.example .env
# Never commit a filled .env. Secrets come from Vault in every deployed
# environment; the values below are placeholders, not defaults.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SERVICE_NAME=communication-gateway
ENVIRONMENT=local
HOST=0.0.0.0
# Local development port. Compose and Kubernetes run the container on 8000,
# which is also the built-in default and the port the image exposes.
PORT=7410
LOG_LEVEL=INFO
# Enables the Nest watch mode in main.ts. Keep false in deployed environments.
HOT_RELOAD=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# postgresql://, postgres://, postgresql+asyncpg:// and
# postgresql+psycopg:// are all accepted; the driver prefixes are stripped
# because the Prisma client only understands postgresql://.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5433/gateway
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Logs every statement the client sends. Development only.
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Internal API key
# ---------------------------------------------------------------------------
# Every REST route, the GraphQL endpoint and the readiness probe except the
# liveness probes require x-internal-api-key to match this value. A missing
# value is a 503, a wrong value is a 401. Production rejects keys shorter
# than 16 characters.
INTERNAL_API_KEY=replace-with-internal-api-key
# Clients use their service-specific setting name, for example
# GATEWAY_API_KEY or COMMUNICATION_GATEWAY_API_KEY, with this same value.

# ---------------------------------------------------------------------------
# Keycloak (identity context of outbound messages)
# ---------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=omnixys
KEYCLOAK_AUDIENCE=account
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Downstream services
# ---------------------------------------------------------------------------
CHAT_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_API_KEY=
NOTIFICATION_SERVICE_URL=http://localhost:7402
NOTIFICATION_SERVICE_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# A provider is registered only when its base credential is set. Resend and
# Stalwart therefore disappear from GET /api/v1/providers once their keys
# or host are empty.

# Evolution API, serves the WHATSAPP channel. The webhook secret is only
# needed for bearer or HMAC verification; the API key alone also accepts
# a webhook that carries apikey in a header or in the body.
EVOLUTION_BASE_URL=http://localhost:7070
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE_NAME=omnixys
EVOLUTION_WEBHOOK_SECRET=your-webhook-secret

# Resend, the default primary email transport.
RESEND_API_KEY=re_replace-with-resend-key
RESEND_FROM_ADDRESS=Omnixys <no-reply@omnixys.com>
RESEND_BASE_URL=https://api.resend.com
RESEND_TIMEOUT=30

# Stalwart, the SMTP fallback for the EMAIL channel.
# STALWART_ENABLED=true plus a host is what registers the adapter.
STALWART_ENABLED=true
STALWART_HOST=host.docker.internal
STALWART_PORT=10587
STALWART_USERNAME=service@omnixys.com
STALWART_PASSWORD=replace-with-service-account-password
STALWART_FROM_ADDRESS=service@omnixys.com
STALWART_TIMEOUT=30
STALWART_PRIORITY=10
STALWART_TLS_ENABLED=true
# Keep true with a publicly trusted production certificate.
STALWART_TLS_VERIFY=false
# STALWART_AUTH_MODE is password or oauthbearer. With password the client
# picks AUTH LOGIN or AUTH PLAIN from the mechanisms the server offers;
# oauthbearer additionally requires the three OAUTH keys below.
STALWART_AUTH_MODE=password
STALWART_OAUTH_TOKEN_URL=
STALWART_OAUTH_CLIENT_ID=
STALWART_OAUTH_CLIENT_SECRET=

# EMAIL_PRIMARY and EMAIL_FALLBACK select the transport per channel.
EMAIL_PRIMARY=resend
EMAIL_FALLBACK=stalwart

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# An empty KAFKA_BROKER disables the event bus; the service then logs that
# cross service events are dropped and stays up.
KAFKA_BROKER=localhost:9092
# Accepted for compatibility only. @omnixys/kafka-ts always produces with
# acks=-1, so this value has no effect.
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_TOPIC_DELIVERY_STATUS=gateway.delivery.status

# ---------------------------------------------------------------------------
# HTTP event forwarder
# ---------------------------------------------------------------------------
# Retries keep the previous defaults: three attempts with exponential
# backoff, jitter and a five second base delay. Every value must be > 0.
FORWARDER_MAX_ATTEMPTS=3
FORWARDER_BASE_DELAY_MS=5000
FORWARDER_MAX_DELAY_MS=30000
FORWARDER_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Leave CACHE_URL empty to keep the cache disabled.
CACHE_URL=
CACHE_KEY_PREFIX=communication-gateway

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
OTEL_TRACING_ENABLED=true
OTEL_SAMPLING_PROBABILITY=0.1
# Only used by the liveness probe when the SDK exports traces.
OTEL_TEMPO_HEALTH_URL=
OTEL_PROMETHEUS_HEALTH_URL=

# ---------------------------------------------------------------------------
# Platform keys that belong to other services
# ---------------------------------------------------------------------------
# ADDRESS_MAPPINGS is a legacy compatibility shim for recipientId callers.
# V1 clients send recipientAddress instead.
# ADDRESS_MAPPINGS={}
# EVOLUTION_CORS_ORIGIN is consumed by the Evolution API container as a CORS
# allowlist entry. It is set for this service in Kubernetes but not read here.
# WHATSAPP_SUPPORT_EVENT_MAP holds the WhatsApp support routing table.
# The provider placeholders of the former Python runtime - Twilio, Mailu,
# Firebase, WhatsApp Cloud API, Signal and Telegram - are gone; the V1
# runtime only ships Evolution, Resend and Stalwart.
