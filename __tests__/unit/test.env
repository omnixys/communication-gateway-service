/**
 * Environment for the Node test runner.
 *
 * The suite runs against `dist`, therefore the sources must be built first.
 * Every value is a placeholder: no test is allowed to reach a real database,
 * broker or provider, so all endpoints point at closed local ports and the
 * gateway runs with both optional dependencies disabled.
 */
ENVIRONMENT=local
LOG_LEVEL=silent
PORT=0

# Tests replace this value with a closed local PostgreSQL URL before importing
# the application. Runtime persistence remains mandatory.
DATABASE_URL=

# Kafka is optional. An empty broker keeps KafkaModule out of the graph.
KAFKA_BROKER=
KAFKA_CLIENT_ID=communication-gateway-test
KAFKA_CONSUMER_GROUP=communication-gateway-test

# Non-empty, so the generated Prisma client never loads the repository .env.
INTERNAL_API_KEY=test-internal-api-key

# External services that the forwarder would call.
CHAT_SERVICE_URL=http://127.0.0.1:9
CHAT_SERVICE_API_KEY=test-chat-key
NOTIFICATION_SERVICE_URL=http://127.0.0.1:9
NOTIFICATION_SERVICE_API_KEY=test-notification-key

# Provider adapters, all inert.
EVOLUTION_BASE_URL=http://127.0.0.1:9
EVOLUTION_API_KEY=test-evolution-key
EVOLUTION_INSTANCE_NAME=communication-gateway-test
RESEND_API_KEY=
EMAIL_PRIMARY=none
STALWART_HOST=127.0.0.1
STALWART_PORT=9
STALWART_USERNAME=test
STALWART_PASSWORD=test
