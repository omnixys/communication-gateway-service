#
# Keep the build context free of secrets and build output. A missing entry
# here would copy a local .env into the image.

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
.npmrc

# Version control and CI
.git
.gitignore
.github
.vscode

# Build output and dependencies
dist
node_modules
coverage
*.tsbuildinfo

# Tests are not part of the runtime image
__tests__

# Tooling caches
.prettiercache
.eslintcache
.extras

# Documentation
docs
CHANGELOG.md
